# =============================================================================
# Oyedesi Frontend — copy to .env and fill in your values
# =============================================================================

# Backend API URL — leave empty to use Vite proxy (/api -> http://127.0.0.1:8000)
VITE_API_URL=

# Google Maps (Maps JavaScript API + Places API for land picker on /farmer/land)
# Get a key: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# Optional — used by some AI / applet features
GEMINI_API_KEY=
APP_URL=http://localhost:3000
