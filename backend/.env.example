DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/oyedesi
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local dev: auto-create tables + seed on API start. Lambda: set false in function env
RUN_STARTUP_INIT=true

# Test admin (dashboard: /admin)
ADMIN_EMAIL=admin@oyedesi.co
ADMIN_PASSWORD=TestAdmin@123

# Test customer (dashboard: /dashboard)
TEST_USER_EMAIL=user@oyedesi.co
TEST_USER_PASSWORD=TestUser@123
TEST_USER_NAME=Test Customer

# Test farmer (dashboard: /farmer)
TEST_FARMER_EMAIL=farmer@oyedesi.co
TEST_FARMER_PASSWORD=TestFarmer@123
TEST_FARMER_NAME=Test Farmer

# Test district hub (dashboard: /hub)
TEST_HUB_EMAIL=hub@oyedesi.co
TEST_HUB_PASSWORD=TestHub@123
TEST_HUB_NAME=District Hub Collector

# OTP (dev mode returns code in API response; set false in production)
OTP_DEV_MODE=true

# KYC / DigiLocker (dev mode auto-verifies valid Aadhaar; set false in production)
KYC_DEV_MODE=true
DIGILOCKER_REDIRECT_BASE=http://localhost:3000/farmer/kyc

# --- AWS Lambda (set in Lambda console / function config, not in the image) ---
# DATABASE_URL=mysql+pymysql://user:pass@your-rds-endpoint.region.rds.amazonaws.com:3306/oyedesi
# SECRET_KEY=long-random-production-secret
# CORS_ORIGINS=https://your-amplify-domain.amplifyapp.com
# RUN_STARTUP_INIT=false
# OTP_DEV_MODE=false
# KYC_DEV_MODE=false
# DIGILOCKER_REDIRECT_BASE=https://your-amplify-domain.amplifyapp.com/farmer/kyc
